{
  "name": "recetario",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pre": "ng build -c production,preproduccion",
    "analizar": "ng build -c production,analisis && node herramientas/peso-por-paquete.mjs",
    "analizar:mapa": "source-map-explorer \"dist/recetario/browser/*.js\" --no-border-checks",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "prettier": "^3.8.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.2"
  }
}
